# ==============================================================
# BharatStore - Configuration & Environment Variables
# ==============================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# If Aiven Cloud or Razorpay credentials are left empty, BharatStore
# automatically activates high-fidelity Local In-Memory / SQLite / Emulation
# mode so all features work completely out-of-the-box!
# ==============================================================

# Server & Application Port
PORT=5000

# Cryptographic Session Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Administrative REST API Key (for /admin inventory reset and stress testing)
ADMIN_API_KEY=

# Maximum allowed quantity per individual cart line-item
MAX_QUANTITY_PER_ITEM=50

# Test & Debug Endpoints (keep false in staging / production)
ALLOW_INSECURE_TEST_ENDPOINTS=false

# --------------------------------------------------------------
# Payment Gateway (Razorpay - Optional for live payments)
# --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --------------------------------------------------------------
# 1. Aiven for PostgreSQL (Optional - falls back to SQLite)
# --------------------------------------------------------------
# Example URI: postgres://avnadmin:password@pg-service.aivencloud.com:12345/defaultdb?sslmode=require
AIVEN_PG_URL=

# Or individual connection parameters:
AIVEN_PG_HOST=
AIVEN_PG_PORT=
AIVEN_PG_USER=
AIVEN_PG_PASSWORD=
AIVEN_PG_DATABASE=defaultdb
AIVEN_PG_SSLMODE=require

# --------------------------------------------------------------
# 2. Aiven for Apache Kafka (Optional - falls back to In-Memory Event Broker)
# --------------------------------------------------------------
# Example: kafka-service.aivencloud.com:12346
AIVEN_KAFKA_BOOTSTRAP_SERVERS=
AIVEN_KAFKA_TOPIC=order-events
AIVEN_KAFKA_CONSUMER_GROUP=bharatstore-inventory-group

# Authentication (SASL_SSL or SSL):
AIVEN_KAFKA_SECURITY_PROTOCOL=SASL_SSL
AIVEN_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
AIVEN_KAFKA_USERNAME=
AIVEN_KAFKA_PASSWORD=

# For SSL Mutual Auth (service.cert, service.key, ca.pem):
AIVEN_KAFKA_CA_CERT=
AIVEN_KAFKA_ACCESS_CERT=
AIVEN_KAFKA_ACCESS_KEY=

# --------------------------------------------------------------
# 3. Aiven for OpenSearch (Optional - falls back to Local Fuzzy Engine)
# --------------------------------------------------------------
# Example: https://avnadmin:password@opensearch-service.aivencloud.com:12347
AIVEN_OPENSEARCH_URL=
AIVEN_OPENSEARCH_INDEX=bharatstore-products
AIVEN_OPENSEARCH_USER=
AIVEN_OPENSEARCH_PASSWORD=
